source "https://rubygems.org"

# Mirrors what GitHub Pages builds with (Jekyll 3.10, kramdown GFM, and the
# whitelisted plugins below). The all-in-one `github-pages` gem is not used
# because its pinned dependencies do not install on Ruby 4.
gem "jekyll", "~> 3.10"
gem "kramdown-parser-gfm"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Former standard-library gems that Jekyll 3 still needs on newer Rubies.
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
